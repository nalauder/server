MYSQL_ROOT_PASS=hashtopolis
MYSQL_DATABASE=hashtopolis
MYSQL_USER=hashtopolis
MYSQL_PASSWORD=hashtopolis

HASHTOPOLIS_ADMIN_USER=admin
HASHTOPOLIS_ADMIN_PASSWORD=hashtopolis
HASHTOPOLIS_DB_HOST=db

HASHTOPOLIS_BACKEND_URL=http://localhost:8080/api/v2

# Extra origins the API shares authenticated responses with. Only needed when the frontend is served
# from a different host than the API; a reverse proxy that serves both from one origin needs nothing
# here, and a frontend that differs only by port is already covered by HASHTOPOLIS_FRONTEND_PORT.
# Comma separated, one exact origin each: scheme, host and port must match, and there are no
# wildcards. Anything listed is trusted with the session cookie, so keep it to origins you control.
#HASHTOPOLIS_FRONTEND_URLS=https://app.example.com

# Switches HASHTOPOLIS_FRONTEND_PORT off, so that HASHTOPOLIS_FRONTEND_URLS above is the whole list of
# trusted origins. Leave it commented out to keep trusting the frontend on port 4200.
#HASHTOPOLIS_FRONTEND_PORT=

# Needed when the frontend is on a different domain than the API, not merely a different host: the
# browser will not send the session cookie cross-site otherwise. Only works over HTTPS end to end.
#HASHTOPOLIS_REFRESH_COOKIE_SAMESITE=None

# Forces the Secure flag on the session cookie. Normally unnecessary, as it follows the scheme the
# request arrived over; set it behind a proxy that terminates TLS without sending X-Forwarded-Proto.
#HASHTOPOLIS_REFRESH_COOKIE_SECURE=true

# Single sign-on with OpenID Connect, see doc/installation_guidelines/oidc-sso.md. Setting the issuer
# enables it; the client ID and secret are then required. For Microsoft Entra ID the issuer is
# https://login.microsoftonline.com/<tenant-id>/v2.0 (never /common). Register
# https://<host>/api/v2/auth/oidc/callback as the redirect URI with the provider.
#HASHTOPOLIS_OIDC_ISSUER=
#HASHTOPOLIS_OIDC_CLIENT_ID=
#HASHTOPOLIS_OIDC_CLIENT_SECRET=
# Optional. Defaults: "openid profile email" and "SSO".
#HASHTOPOLIS_OIDC_SCOPES=openid profile email
#HASHTOPOLIS_OIDC_DISPLAY_NAME=SSO

# Set to false to turn off password login once single sign-on works. Ignored while single sign-on is
# not fully configured.
#HASHTOPOLIS_LOCAL_LOGIN_ENABLED=true
